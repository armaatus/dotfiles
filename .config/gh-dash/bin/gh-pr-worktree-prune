#!/usr/bin/env bash
# Clean up after PRs that are merged or closed: remove their .worktrees/pr-N worktree,
# kill their `<repo>-<N>` review tmux session and clear their tuicr session. Only touches
# what gh-pr-worktree / gh-pr-review created, and skips worktrees with uncommitted changes.
#
#   gh-pr-worktree-prune [--dry-run]
set -euo pipefail

CONFIG_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
dry_run=false
[[ "${1:-}" == "--dry-run" ]] && dry_run=true

sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)

awk '
  /^repoPaths:/ { in_paths = 1; next }
  in_paths && /^[^ ]/ { in_paths = 0 }
  in_paths && NF == 2 { sub(/:$/, "", $1); print $1, $2 }' "$CONFIG_DIR/common.yml" |
while read -r repo clone; do
  clone=${clone/#\~/$HOME}
  name=${repo##*/}

  # PR numbers that have a worktree or a review session.
  nums=$( { for dir in "$clone"/.worktrees/pr-*; do [[ -d "$dir" ]] && echo "${dir##*/pr-}"; done
            grep -E "^$name-[0-9]+$" <<<"$sessions" | sed "s/^$name-//" || true; } | sort -un)

  for num in $nums; do
    state=$(gh pr view "$num" -R "$repo" --json state --jq .state)
    [[ $state == OPEN ]] && continue
    dir="$clone/.worktrees/pr-$num"

    if [[ -d "$dir" && -n "$(git -C "$dir" status --porcelain)" ]]; then
      echo "skip  $repo#$num ($state) has uncommitted changes: $dir"
      continue
    fi
    if $dry_run; then
      echo "would clean up  $repo#$num ($state)"
      continue
    fi
    [[ -d "$dir" ]] && git -C "$clone" worktree remove "$dir"
    tmux kill-session -t "=$name-$num" 2>/dev/null || true
    tuicr review clear --session "gh:$repo/pr/$num" >/dev/null 2>&1 || true
    echo "cleaned up  $repo#$num ($state)"
  done
  $dry_run || git -C "$clone" worktree prune
done
